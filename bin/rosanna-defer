#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer のプロキシが教える場所を先に見る。symlink で入れると __DIR__ は実体のパスで、プロジェクトの場所が分からない
$composerAutoload = isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])
    ? (realpath($GLOBALS['_composer_autoload_path']) ?: null)
    : null;

// パッケージのルートで実行した場合と、依存として入った場合 (RT-13.1)
foreach ([$composerAutoload, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if ($autoload !== null && file_exists($autoload)) {
        require $autoload;
        break;
    }
}

$fail = static function (string $message): int {
    fwrite(STDERR, "Error: {$message}\n");

    return 1;
};

$help = static function (): void {
    echo <<<'HELP'
        Rosanna Defer CLI

        Usage:
          rosanna-defer <command>

        Commands:
          publish    Copy rosanna-defer.js to your project's public directory
          compile    Compile .psx files and generate the manifest and the deferred manifest
          help       Show this help message

        Compile options:
          rosanna-defer compile [options] [paths...]

          Paths are files or directories (default: ./components). A path that does not
          exist is an error.

          --check               Verify compiled files are up to date, without writing them (CI use)
          --clean               Remove the contents of the cache directory
          --watch               Recompile when a .psx file changes (Ctrl+C to stop)
          --cache=PATH          Cache directory for compiled files and the manifest
                                (default: ./var/cache/psx)

        Examples:
          ./vendor/bin/rosanna-defer publish
          ./vendor/bin/rosanna-defer compile components/
          ./vendor/bin/rosanna-defer compile --check

        HELP;
    echo "\n";
};

$publish = static function () use ($fail, $composerAutoload): int {
    // RT-13.2 パッケージの 3 階層上が vendor
    $vendorDir = $composerAutoload !== null ? dirname($composerAutoload) : dirname(__DIR__, 3);
    if ($composerAutoload === null && basename($vendorDir) !== 'vendor') {
        // RT-13.3
        echo "Note: running from the package root. rosanna-defer.js is already in public/\n";

        return 0;
    }

    $source = dirname(__DIR__) . '/public/rosanna-defer.js';
    if (!is_file($source)) {
        return $fail('rosanna-defer.js source not found');
    }

    $targetDir = dirname($vendorDir) . '/public';
    if (!is_dir($targetDir)) {
        if (!@mkdir($targetDir, 0o755, true) && !is_dir($targetDir)) {
            return $fail("could not create directory {$targetDir}");
        }
        echo "Created directory: {$targetDir}\n";
    }

    $target = $targetDir . '/rosanna-defer.js';
    if (!@copy($source, $target)) {
        return $fail("could not copy rosanna-defer.js to {$target}");
    }

    echo "Published rosanna-defer.js to {$target}\n";

    return 0;
};

$compile = static function (array $arguments): int {
    // CP-140
    return new \Polidog\Rosanna\Psx\CompileCommand(new \Polidog\Rosanna\Defer\DeferredManifestCompiler()->compile(...))->run($arguments, getcwd() ?: '.');
};

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'publish':
        exit($publish());

    case 'compile':
        exit($compile(array_slice($argv, 2)));

    case 'help':
        $help();
        exit(0);

    default:
        // RT-13.9
        fwrite(STDERR, "Unknown command: {$command}\n\n");
        $help();
        exit(1);
}
